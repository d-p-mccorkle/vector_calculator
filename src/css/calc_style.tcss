/* Style sheet for the calculator.  All styling edits for the
 * program should reside only in this file
 */

Screen {
    layout: grid;
    grid-size: 4 6;
    background: #32302F;
    align: center middle;
  }

Input {
  border: solid #98971A;
  height: auto;
  width: auto;
  background: #32302F;
  }

.cntnr {
    column-span: 4;
    border: solid #D65D0E;
    height: 100%;
    width: 100%;
    background: #32302F;
    align: center middle;
    border_title-align: left;
  }

.cntnr_ops {
  column-span: 2;
  border: solid #D65D0E;
  height: 100%;
  background: #32302F;
  align: center middle;
  border_title-align: left;
  border_subtitle-align: right;
  }

.opr {
   border: solid #98971A;
   background: #32302F;
   content-align: center middle;
   width: 24;
  }

.store {
    border: solid #458588;
    background: #32302F;
    content-align: center middle;
    height: auto;
    width: auto;
  }

.op2_but {
  border: solid #FABD2F;
  background: #32302F;
  content-align: center middle;
  height: auto;
  width: 50%;
  }

.op1_but {
    border: solid #8EC07C;
    background: #32302F;
    content-align: center middle;
    height: auto;
    width: 50%;
  }

#oprtns_1 {
  row-span: 2;
  layout: grid;
  grid-size: 2 2;
}

#oprtns_2 {
  row-span: 3;
  layout: grid;
  grid-size: 2 4;
}

#theta_scal {
  row-span: 1;
  border_subtitle-align: right;
}

#output {
    column-span: 4;
    border: solid #D65D0E;
    height: 100%;
    width: 100%;
    background: #32302F;
    content-align: center middle;
    border_title-align: left;
    border_subtitle-align: right;
}

#test_wid {
  border: solid #D65D0E;
  height: 75%;
  width: 75%;
  background: #32302F;
  content-align: center middle;
}
